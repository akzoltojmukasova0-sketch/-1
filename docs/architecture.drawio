<mxfile host="app.diagrams.net"><diagram id="arch2" name="Архитектура RouteScore"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1090" background="#f5f7fb" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="1. Клиентский уровень — представление (браузер, телефон)" style="swimlane;startSize=30;align=left;spacingLeft=12;rounded=1;arcSize=3;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#d6e3ff;swimlaneFillColor=#eef3ff;strokeColor=#3b6fd8;fontColor=#1d2433;strokeWidth=2;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1220" height="215" as="geometry"/></mxCell><mxCell id="cd" value="&lt;b&gt;Диспетчер&lt;/b&gt;&lt;br&gt;создаёт и назначает маршруты" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b6fd8;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="b1"><mxGeometry x="30" y="45" width="275" height="70" as="geometry"/></mxCell><mxCell id="cc" value="&lt;b&gt;Курьер (с телефона)&lt;/b&gt;&lt;br&gt;отмечает доставки, шлёт GPS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b6fd8;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="b1"><mxGeometry x="325" y="45" width="275" height="70" as="geometry"/></mxCell><mxCell id="cm" value="&lt;b&gt;Менеджер по логистике&lt;/b&gt;&lt;br&gt;смотрит KPI и отчёты" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b6fd8;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="b1"><mxGeometry x="620" y="45" width="275" height="70" as="geometry"/></mxCell><mxCell id="ca" value="&lt;b&gt;Администратор&lt;/b&gt;&lt;br&gt;нормативы, пользователи, транспорт" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b6fd8;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="b1"><mxGeometry x="915" y="45" width="275" height="70" as="geometry"/></mxCell><mxCell id="react" value="&lt;b&gt;React SPA (TypeScript)&lt;/b&gt;&lt;br&gt;Единый интерфейс: панель диспетчера, режим курьера на телефоне, дашборд KPI, отчёты" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b6fd8;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="b1"><mxGeometry x="30" y="150" width="1160" height="55" as="geometry"/></mxCell><mxCell id="b2" value="2. Серверный уровень — NestJS (приложение)" style="swimlane;startSize=30;align=left;spacingLeft=12;rounded=1;arcSize=3;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#cfeedd;swimlaneFillColor=#ecf8f1;strokeColor=#2e9c63;fontColor=#1d2433;strokeWidth=2;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="1220" height="470" as="geometry"/></mxCell><mxCell id="guards" value="&lt;b&gt;Auth + Guards&lt;/b&gt;&lt;br&gt;Проверка JWT-токена и роли пользователя (RBAC) — до выполнения любой логики" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e9c63;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="b2"><mxGeometry x="30" y="30" width="1160" height="50" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;b&gt;Controller (REST API)&lt;/b&gt;&lt;br&gt;Принимает HTTP-запросы, проверяет данные (DTO), передаёт их в Service нужного модуля" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e9c63;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="b2"><mxGeometry x="30" y="110" width="1160" height="50" as="geometry"/></mxCell><mxCell id="mods" value="Модули предметных областей (Service — бизнес-логика)" style="swimlane;startSize=28;align=left;spacingLeft=12;rounded=1;arcSize=3;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#cfeedd;swimlaneFillColor=#ffffff;strokeColor=#2e9c63;fontColor=#1d2433;strokeWidth=2;collapsible=0;" vertex="1" parent="b2"><mxGeometry x="20" y="190" width="1180" height="180" as="geometry"/></mxCell><mxCell id="m_auth" value="&lt;b&gt;Auth / Users&lt;/b&gt;&lt;br&gt;Вход, роли, профили" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecf8f1;strokeColor=#2e9c63;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="mods"><mxGeometry x="12" y="36" width="268" height="52" as="geometry"/></mxCell><mxCell id="m_fleet" value="&lt;b&gt;Fleet&lt;/b&gt;&lt;br&gt;Транспорт и склады" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecf8f1;strokeColor=#2e9c63;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="mods"><mxGeometry x="308" y="36" width="268" height="52" as="geometry"/></mxCell><mxCell id="m_routes" value="&lt;b&gt;Routes&lt;/b&gt;&lt;br&gt;Маршруты и доставки" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecf8f1;strokeColor=#2e9c63;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="mods"><mxGeometry x="604" y="36" width="268" height="52" as="geometry"/></mxCell><mxCell id="m_int" value="&lt;b&gt;Integrations&lt;/b&gt;&lt;br&gt;Клиенты внешних API" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecf8f1;strokeColor=#2e9c63;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="mods"><mxGeometry x="900" y="36" width="268" height="52" as="geometry"/></mxCell><mxCell id="m_an" value="&lt;b&gt;Analytics&lt;/b&gt;&lt;br&gt;KPI и индекс эффективности" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecf8f1;strokeColor=#2e9c63;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="mods"><mxGeometry x="12" y="116" width="268" height="52" as="geometry"/></mxCell><mxCell id="m_rep" value="&lt;b&gt;Reports&lt;/b&gt;&lt;br&gt;Отчёты PDF / Excel" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecf8f1;strokeColor=#2e9c63;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="mods"><mxGeometry x="308" y="116" width="268" height="52" as="geometry"/></mxCell><mxCell id="m_ref" value="&lt;b&gt;Reference&lt;/b&gt;&lt;br&gt;Нормативы и веса KPI" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecf8f1;strokeColor=#2e9c63;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="mods"><mxGeometry x="604" y="116" width="268" height="52" as="geometry"/></mxCell><mxCell id="m_trk" value="&lt;b&gt;Tracking&lt;/b&gt;&lt;br&gt;Приём и хранение GPS-точек" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecf8f1;strokeColor=#2e9c63;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="mods"><mxGeometry x="900" y="116" width="268" height="52" as="geometry"/></mxCell><mxCell id="orm" value="&lt;b&gt;ORM — Prisma&lt;/b&gt;&lt;br&gt;Единственная точка доступа backend к БД: превращает вызовы модулей в SQL" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe3f1;strokeColor=#d6337f;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="b2"><mxGeometry x="30" y="400" width="1160" height="50" as="geometry"/></mxCell><mxCell id="b3" value="3. Уровень данных" style="swimlane;startSize=30;align=left;spacingLeft=12;rounded=1;arcSize=3;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#dfd2ff;swimlaneFillColor=#f3eeff;strokeColor=#7a56d6;fontColor=#1d2433;strokeWidth=2;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="855" width="1220" height="200" as="geometry"/></mxCell><mxCell id="db" value="PostgreSQL — 9 таблиц" style="swimlane;startSize=28;align=left;spacingLeft=12;rounded=1;arcSize=3;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#dfd2ff;swimlaneFillColor=#ffffff;strokeColor=#7a56d6;fontColor=#1d2433;strokeWidth=2;collapsible=0;" vertex="1" parent="b3"><mxGeometry x="30" y="40" width="1160" height="150" as="geometry"/></mxCell><mxCell id="t0" value="users — пользователи" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#f3eeff;strokeColor=#7a56d6;fontColor=#1d2433;fontSize=12;strokeWidth=1.5;" vertex="1" parent="db"><mxGeometry x="9" y="40" width="215" height="36" as="geometry"/></mxCell><mxCell id="t1" value="warehouses — склады" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#f3eeff;strokeColor=#7a56d6;fontColor=#1d2433;fontSize=12;strokeWidth=1.5;" vertex="1" parent="db"><mxGeometry x="241" y="40" width="215" height="36" as="geometry"/></mxCell><mxCell id="t2" value="vehicles — транспорт" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#f3eeff;strokeColor=#7a56d6;fontColor=#1d2433;fontSize=12;strokeWidth=1.5;" vertex="1" parent="db"><mxGeometry x="473" y="40" width="215" height="36" as="geometry"/></mxCell><mxCell id="t3" value="routes — маршруты" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#f3eeff;strokeColor=#7a56d6;fontColor=#1d2433;fontSize=12;strokeWidth=1.5;" vertex="1" parent="db"><mxGeometry x="705" y="40" width="215" height="36" as="geometry"/></mxCell><mxCell id="t4" value="deliveries — доставки" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#f3eeff;strokeColor=#7a56d6;fontColor=#1d2433;fontSize=12;strokeWidth=1.5;" vertex="1" parent="db"><mxGeometry x="937" y="40" width="215" height="36" as="geometry"/></mxCell><mxCell id="t5" value="gps_tracks — GPS-точки" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#f3eeff;strokeColor=#7a56d6;fontColor=#1d2433;fontSize=12;strokeWidth=1.5;" vertex="1" parent="db"><mxGeometry x="9" y="90" width="215" height="36" as="geometry"/></mxCell><mxCell id="t6" value="efficiency_scores — оценки" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#f3eeff;strokeColor=#7a56d6;fontColor=#1d2433;fontSize=12;strokeWidth=1.5;" vertex="1" parent="db"><mxGeometry x="241" y="90" width="215" height="36" as="geometry"/></mxCell><mxCell id="t7" value="kpi_rules — нормативы KPI" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#f3eeff;strokeColor=#7a56d6;fontColor=#1d2433;fontSize=12;strokeWidth=1.5;" vertex="1" parent="db"><mxGeometry x="473" y="90" width="215" height="36" as="geometry"/></mxCell><mxCell id="t8" value="reports — отчёты" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#f3eeff;strokeColor=#7a56d6;fontColor=#1d2433;fontSize=12;strokeWidth=1.5;" vertex="1" parent="db"><mxGeometry x="705" y="90" width="215" height="36" as="geometry"/></mxCell><mxCell id="p_how" value="&lt;b&gt;Как читать схему&lt;/b&gt;&lt;br&gt;• Задача: сравнить план и факт доставки и посчитать KPI&lt;br&gt;• Три уровня: клиент → сервер → база данных&lt;br&gt;• Клиент не обращается к БД напрямую&lt;br&gt;• Жёлтые кружки 1–7 — путь одного запроса&lt;br&gt;• Стрелки двусторонние: запрос и ответ&lt;br&gt;• Подписи на стрелках — протокол или смысл&lt;br&gt;• Оранжевый блок — внешние сервисы" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fillColor=#ffffff;strokeColor=#aab3cc;fontColor=#1d2433;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1350" y="90" width="410" height="215" as="geometry"/></mxCell><mxCell id="p_steps" value="&lt;b&gt;Путь запроса: менеджер оценивает маршрут № 17&lt;/b&gt;&lt;br&gt;1  Менеджер нажимает «Оценить маршрут»&lt;br&gt;2  POST /api/routes/17/evaluation + JWT по HTTPS&lt;br&gt;3  Guards проверяют токен и роль, Controller — данные&lt;br&gt;4  Analytics запрашивает план, факт и GPS-треки&lt;br&gt;5  ORM выполняет SQL-запросы к PostgreSQL&lt;br&gt;6  Analytics считает KPI, индекс 0–100, сохраняет оценку&lt;br&gt;7  JSON-ответ показывается в интерфейсе" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fillColor=#ffffff;strokeColor=#aab3cc;fontColor=#1d2433;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1350" y="345" width="410" height="175" as="geometry"/></mxCell><mxCell id="c_ext" value="Внешние сервисы" style="swimlane;startSize=28;align=left;spacingLeft=12;rounded=1;arcSize=3;html=1;whiteSpace=wrap;fontStyle=1;fontSize=14;fillColor=#ffe0b3;swimlaneFillColor=#fff4e5;strokeColor=#e08a1e;fontColor=#1d2433;strokeWidth=2;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1350" y="535" width="410" height="190" as="geometry"/></mxCell><mxCell id="ext1" value="&lt;b&gt;Сервис маршрутов и карт&lt;/b&gt;&lt;br&gt;расстояние, время в пути, пробки" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e08a1e;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="c_ext"><mxGeometry x="20" y="32" width="370" height="60" as="geometry"/></mxCell><mxCell id="ext2" value="&lt;b&gt;GPS-трекеры ТС (опционально)&lt;/b&gt;&lt;br&gt;телематика: координаты и скорость" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e08a1e;fontColor=#1d2433;fontSize=14;strokeWidth=2;" vertex="1" parent="c_ext"><mxGeometry x="20" y="112" width="370" height="60" as="geometry"/></mxCell><mxCell id="p_kpi" value="&lt;b&gt;Как считается эффективность&lt;/b&gt;&lt;br&gt;Индекс (0–100) = сумма: вес × показатель&lt;br&gt;• своевременность доставки — вес 35%&lt;br&gt;• план км / факт км — 25%&lt;br&gt;• доля успешных доставок — 20%&lt;br&gt;• загрузка транспорта — 10%&lt;br&gt;• стоимость одной доставки — 10%&lt;br&gt;≥ 80 — высокая эффективность&lt;br&gt;60–79 — средняя, ниже 60 — низкая&lt;br&gt;Веса и пороги лежат в таблице kpi_rules&lt;br&gt;и меняются администратором&lt;br&gt;Каждый показатель приводится к шкале 0–100:&lt;br&gt;своевременность = доставки в срок / все × 100" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fillColor=#ffffff;strokeColor=#aab3cc;fontColor=#1d2433;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1350" y="745" width="410" height="310" as="geometry"/></mxCell><mxCell id="e_cd" style="endArrow=classic;startArrow=classic;endFill=1;startFill=1;html=1;rounded=0;strokeColor=#2b3350;strokeWidth=2;exitX=0.498;exitY=1;exitDx=0;exitDy=0;entryX=0.118;entryY=0;entryDx=0;entryDy=0;" edge